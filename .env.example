# ============================================================
#  AdilaNet — Environment Variables
#  Salin file ini ke .env dan isi nilainya
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Set only to a GHCR image reference that has been published and verified.
# Leave blank until the repository owner provides the exact image tag.
ADILANET_IMAGE=

# ── Database PostgreSQL ──────────────────────────────────────
# For Docker, use the same password already configured for the existing DB volume.
# Keep this file blank; configure actual values only in the private, ignored .env.
POSTGRES_PASSWORD=
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME (URL-encode special characters)
DATABASE_URL=

# ── Keamanan Sesi (WAJIB) ────────────────────────────────────
# Wajib. Untuk deployment lama, gunakan SESSION_SECRET yang sudah ada;
# jangan menggantinya saat memperbarui compose karena sesi aktif dapat berakhir.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── URL Publik Aplikasi ──────────────────────────────────────
# Dipakai untuk callback webhook QRIS / payment
APP_URL=http://IP_SERVER_KAMU:5000

# ── Secure Cookie (HTTPS) ────────────────────────────────────
# Biarkan kosong/false kalau akses lewat HTTP (mis. IP LAN) — kalau diisi
# "true" tapi server masih HTTP, login akan auto-logout terus.
# Set "true" HANYA jika app dilayani lewat HTTPS (domain + TLS / reverse proxy).
COOKIE_SECURE=false

# Kredensial QRIS Qiospay diisi secara privat melalui Admin → Setelan.

# ── PPOB Digiflazz Buyer API (opsional, tetap terkunci jika kosong) ──
# Simpan melalui Replit Secrets atau .env privat untuk self-hosting.
# Webhook secret minimal 32 karakter; samakan dengan menu webhook Digiflazz.
# Transaksi nyata hanya melalui HTTPS + COOKIE_SECURE=true.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_WEBHOOK_SECRET=

# ── Gemini AI (opsional) ─────────────────────────────────────
GEMINI_API_KEY=
